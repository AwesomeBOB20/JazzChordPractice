{
  "expo": {
    "name": "Kordal",
    "slug": "jazzchordpractice",
    "owner": "anthonysteller314s-organization",
    "version": "1.0.0",
    "newArchEnabled": true,
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f0f1e"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f0f1e"
      },
      "package": "com.awesomebob20.kordal",
      "versionCode": 1,
      "minSdkVersion": 26,
      "abiFilters": [
        "arm64-v8a",
        "armeabi-v7a"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.awesomebob20.kordal",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Kordal uses the microphone for the guitar tuner to detect the pitch of the notes you play."
      }
    },
    "extra": {
      "eas": {
        "projectId": "77289a83-730c-47a4-91e8-506996539689"
      }
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "targetSdkVersion": 35,
            "compileSdkVersion": 35
          }
        }
      ]
    ]
  }
}
